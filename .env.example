############################################
# Bybit (Testnet) credentials + endpoints
############################################
#
# IMPORTANT:
# - Never commit real keys.
# - Testnet keys are created in the Bybit Testnet portal.
#
# Required for live mode:
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Runtime toggle
BYBIT_TESTNET=true

# Bybit v5 REST base URL (testnet)
BYBIT_REST_BASE_URL=https://api-testnet.bybit.com

# Bybit v5 WebSocket URLs (testnet)
# Public market data
BYBIT_WS_PUBLIC_SPOT_URL=wss://stream-testnet.bybit.com/v5/public/spot
BYBIT_WS_PUBLIC_LINEAR_URL=wss://stream-testnet.bybit.com/v5/public/linear
BYBIT_WS_PUBLIC_OPTION_URL=wss://stream-testnet.bybit.com/v5/public/option
# Private account/trading stream (if/when used)
BYBIT_WS_PRIVATE_URL=wss://stream-testnet.bybit.com/v5/private

############################################
# Symbol conventions
############################################
#
# The project uses a canonical form like "USDC/USDT".
# Bybit uses symbols without a slash, e.g. "USDCUSDT".
#
# Default target from the spec:
DEFAULT_SYMBOL=USDC/USDT
BYBIT_SPOT_SYMBOL=USDCUSDT

# Perp and option symbols vary by testnet availability.
# See docs/EXCHANGE.md for how to discover supported symbols.
BYBIT_LINEAR_SYMBOL=
BYBIT_OPTION_SYMBOL=
