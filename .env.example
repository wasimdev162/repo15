# Bybit API Configuration
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Use testnet environment
BYBIT_TESTNET=true

# Bybit Testnet Base URLs
BYBIT_REST_BASE_URL=https://api-testnet.bybit.com
BYBIT_WS_PUBLIC_URL=wss://stream-testnet.bybit.com/v5/public/spot
BYBIT_WS_PRIVATE_URL=wss://stream-testnet.bybit.com/v5/private

# Trading Configuration
# Default symbols (comma-separated)
SYMBOLS=USDC/USDT

# Account Balances (approximate, for reference)
# USDT: ~9900
# USDC: ~97

# Risk Limits (optional)
MAX_ORDER_SIZE_USDC=10
MAX_ORDER_SIZE_USDT=10
MAX_POSITION_SIZE=100

# Logging Configuration
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/trading.jsonl

# Runtime Defaults (can be overridden by CLI)
DEFAULT_RUN_SECONDS=60
DEFAULT_MODE=live
DEFAULT_INSTRUMENT=spot
