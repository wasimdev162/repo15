# Bybit API credentials (testnet)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Toggle testnet (true/false)
BYBIT_TESTNET=true

# Bybit v5 base URLs (testnet)
BYBIT_REST_URL=https://api-testnet.bybit.com
BYBIT_WS_PUBLIC_URL=wss://stream-testnet.bybit.com/v5/public
BYBIT_WS_PRIVATE_URL=wss://stream-testnet.bybit.com/v5/private

# Defaults used by CLI/config
DEFAULT_SYMBOL=USDC/USDT
DEFAULT_INSTRUMENT=spot
MODE=live
RUN_SECONDS=60
